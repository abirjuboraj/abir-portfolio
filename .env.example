# ==============================================================================
# Contact Form Backend Email Configuration (Optional)
# If left blank, inquiries are safely saved locally to messages.json and logged.
# ==============================================================================

# Option 1: Direct SMTP via Gmail, Outlook, or Custom Domain (Recommended)
# For Gmail: Use your full Gmail address and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
CONTACT_RECEIVER_EMAIL=juboraj9990@gmail.com

# Option 2: Formspree (Alternative)
# Obtain your Form ID from https://formspree.io
FORMSPREE_ID=your_formspree_form_id_here
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id_here
